#!/bin/sh
# Pre-push: corre las pruebas de layout móvil y de galería. Bloquea el push
# SOLO si alguna prueba corre y detecta una regresión real (código de salida 3).
# Si no se puede correr (node ausente, Chromium no arranca, etc. — típico al
# empujar desde GitHub Desktop u otra GUI), advierte y DEJA pasar el push.
# Para saltarlo a propósito: git push --no-verify

echo "→ pre-push: prueba de layout móvil…"

# Las GUIs (GitHub Desktop, etc.) no heredan el PATH de Node. Agregar las
# ubicaciones comunes de Windows para poder encontrar node igualmente.
for dir in "/c/Program Files/nodejs" "/c/Program Files (x86)/nodejs"; do
  [ -d "$dir" ] && PATH="$dir:$PATH"
done
export PATH

# Llamar a 'node' directamente (binario limpio), no a 'npm' (su wrapper de
# Git-for-Windows resuelve mal su ruta y rompe en entornos de GUI).
if ! command -v node >/dev/null 2>&1; then
  echo "⚠ node no disponible en este entorno — se OMITE la prueba móvil (push permitido)." >&2
  echo "  Corre 'npm run test:mobile' manualmente antes de subir cambios de layout." >&2
  exit 0
fi

node test/mobile.mjs
status=$?

if [ "$status" -eq 3 ]; then
  echo "" >&2
  echo "✗ La prueba detectó una regresión de layout móvil — push abortado." >&2
  echo "  Corrige el problema, o usa 'git push --no-verify' para saltar el hook." >&2
  exit 1
fi

if [ "$status" -ne 0 ]; then
  echo "⚠ No se pudo correr la prueba (código $status, probablemente entorno) — push permitido." >&2
  echo "  Corre 'npm run test:mobile' manualmente para verificar." >&2
  exit 0
fi

echo "✓ Layout móvil OK."

echo "→ pre-push: prueba de galería…"

node test/gallery.mjs
status=$?

if [ "$status" -eq 3 ]; then
  echo "" >&2
  echo "✗ La prueba detectó un problema en la galería — push abortado." >&2
  echo "  Corrige el problema, o usa 'git push --no-verify' para saltar el hook." >&2
  exit 1
fi

if [ "$status" -ne 0 ]; then
  echo "⚠ No se pudo correr la prueba de galería (código $status) — push permitido." >&2
  echo "  Corre 'npm run test:gallery' manualmente para verificar." >&2
  exit 0
fi

echo "✓ Galería OK — continuando con el push."
exit 0
